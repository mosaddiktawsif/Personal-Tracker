# Copy this file to .env before running anything:
#   cp .env.example .env
#
# The values below match docker-compose.yml, which starts Postgres locally.

# Postgres connection string. Host:port/database — credentials before the @.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/backend_dev

# HTTP server
HOST=127.0.0.1
PORT=3000

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# "development" lets this file win over your shell environment.
# "production" flips that: the platform's injected variables win, and .env is ignored.
NODE_ENV=development
